# pyenv
#   For a library or app, you might want to share your .python-version if the
#   project is co-developed in multiple versions of Python.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if the platform is not the same, the lock file could prevent installation.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains exact versions of dependencies and should be checked in.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains exact versions of dependencies and should be checked in.
#pdm.lock

